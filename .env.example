MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/wedahub
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated exact origins. Use the Vercel production URL on Render.
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
PORT=3000
# Optional override for local DNS problems; normally leave unset on Render.
